manifest {
    name            = 'virscan-explorer'
    description     = 'Interactive visualization of organism-level VirScan (PhIP-Flow) results'
    author          = 'Fred Hutch'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    inputs             = null
    input_names        = null
    metadata           = null
    outdir             = 'results'
    sample_id_column   = 'vs_id'
    participant_column = null
    virus_annotations  = null

    // Mixed models are fitted on one score against one time variable; fitting every
    // combination would be thousands of models for a page nobody reads that way.
    model_score        = 'gmean_ebs_hits'
    model_time_column  = null
    model_min_hit_rate = 0.1
    help               = false

    // uv is used to install the Python dependencies at run time, so no image needs
    // to be built or maintained for this workflow.
    //
    // These are the full bookworm images rather than the -slim variants specifically
    // because the slim ones omit procps. Nextflow shells out to `ps` to collect task
    // metrics, and without it every task fails outright rather than merely losing its
    // metrics. Any replacement image must provide `ps`.
    python_container = 'ghcr.io/astral-sh/uv:python3.12-bookworm'
    node_container   = 'node:22-bookworm'
}

// bin/ is on PATH inside every task.
process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: process_medium {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // Runs the scripts directly against locally installed uv and node, for developing
    // without a container runtime.
    local {
        process.container = null
        docker.enabled    = false
    }
}

// Task metrics need `ps` inside the container; see the note on the container images
// above. Cirro captures its own copies of these as WORKFLOW_REPORT, WORKFLOW_TIMELINE
// and WORKFLOW_TRACE artifacts, so these files are mainly for running outside Cirro.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
